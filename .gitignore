# ---- Machine learning: datasets, environments, training outputs ------------
# The shipped model is app/src/main/assets/food_model.tflite; datasets (~9 GB) are downloaded
# separately (see ml/train_model.py). Training exports keep only their small evaluation reports
# (*.txt, quoted in docs/MODEL_CARD.md); models and logs are regenerated by the scripts.
ml/data/
ml/.venv/
ml/export*/*
!ml/export*/*.txt
ml/scratch/
__pycache__/
*.pyc
*.tflite
!app/src/main/assets/food_model.tflite
*.keras
*.h5

# ---- Local working files (not part of the published project) ---------------
.remember/
.claude/
PROMPT.md
PLAN.md
ARCHITECTURE_AND_FEATURES.md
PROJECT_PHASES_AND_FEATURES.md
docs/archive/
docs/demo.mp4
# Screenshots of earlier designs stay local; the README uses the current app_*.png set.
docs/screenshots/*
!docs/screenshots/app_*.png
