<?xml version="1.0" encoding="utf-8"?>
<!-- A saved meal (Home "Recent meals", History). The whole card is the tap target. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.NutriLens.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgMeal"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/colorSurfaceVariant"
            android:contentDescription="@string/cd_meal_photo"
            android:padding="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.NutriLens.Rounded" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/NL.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvInfo"
                style="@style/NL.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/NL.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCuisineBadge"
            style="@style/NL.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/indian_cuisine_badge"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
