<?xml version="1.0" encoding="utf-8"?>
<!--
  Home: today's ring and macros, other ways to log, today's meals by slot, then food to eat
  (suggestions and Indian favourites, with photos).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <!-- Greeting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/NL.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/NL.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReminder"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_round_surface"
                android:contentDescription="@string/cd_reminder"
                android:scaleType="center"
                android:src="@drawable/ic_bell"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Today: ring + macros -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/todayCard"
            style="@style/Widget.NutriLens.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:contentDescription="@string/cd_today_s_calories_opens_today_s_breakdo"
            android:focusable="true"
            app:cardCornerRadius="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp">

                    <com.nutrilens.ai.ui.common.CalorieRingView
                        android:id="@+id/ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCalories"
                            style="@style/NL.Number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30sp" />

                        <TextView
                            android:id="@+id/tvGoal"
                            style="@style/NL.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_bold"
                        android:textColor="@color/brand_green"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/NL.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/protein" />

                    <TextView
                        android:id="@+id/tvProtein"
                        style="@style/NL.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressProtein"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        app:indicatorColor="@color/macro_protein"
                        app:trackThickness="6dp" />

                    <TextView
                        style="@style/NL.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/carbs" />

                    <TextView
                        android:id="@+id/tvCarbs"
                        style="@style/NL.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCarbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        app:indicatorColor="@color/macro_carbs"
                        app:trackThickness="6dp" />

                    <TextView
                        style="@style/NL.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/fat" />

                    <TextView
                        android:id="@+id/tvFat"
                        style="@style/NL.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressFat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        app:indicatorColor="@color/macro_fat"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Other ways to log (scanning a photo is the round button below) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/actionBarcode"
                layout="@layout/item_action_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/actionFind"
                layout="@layout/item_action_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/actionThali"
                layout="@layout/item_action_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Today's meals by slot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/NL.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/todays_meals" />

            <TextView
                android:id="@+id/tvViewAll"
                style="@style/NL.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-8dp"
                android:text="@string/view_all" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.NutriLens.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:stateListAnimator="@null">

            <LinearLayout
                android:id="@+id/slotList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_slot_inset"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick add: favourites and frequent foods, with photos -->
        <TextView
            android:id="@+id/tvQuickTitle"
            style="@style/NL.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:text="@string/quick_add"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/quickScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="-20dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsQuick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- What to eat next -->
        <TextView
            android:id="@+id/tvNextMealTitle"
            style="@style/NL.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityHeading="true"
            android:text="@string/what_to_eat_next" />

        <TextView
            android:id="@+id/tvNextMealHint"
            style="@style/NL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nextMealCard"
            style="@style/Widget.NutriLens.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:stateListAnimator="@null">

            <LinearLayout
                android:id="@+id/nextMealList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_photo_inset"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Indian favourites -->
        <LinearLayout
            android:id="@+id/cardIndianDishes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/NL.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/explore_indian_cuisine" />

                <TextView
                    android:id="@+id/tvSeeAllIndian"
                    style="@style/NL.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-8dp"
                    android:text="@string/see_all_indian_count" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginEnd="-20dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutIndianDishes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
