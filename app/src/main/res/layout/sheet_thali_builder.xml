<?xml version="1.0" encoding="utf-8"?>
<!-- Build a thali: pick a combination, untick what you didn't eat, log it as one meal. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/NL.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/build_thali" />

        <TextView
            style="@style/NL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/thali_hint" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsThaliPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvThaliCalories"
                style="@style/NL.Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp" />

            <TextView
                style="@style/NL.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/kcal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvThaliMacros"
            style="@style/NL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <!-- Dishes -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.NutriLens.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:stateListAnimator="@null">

            <LinearLayout
                android:id="@+id/layoutThaliDishes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_inset"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsThaliSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:checkedChip="@id/thaliSlotLunch"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/thaliSlotBreakfast"
                style="@style/Widget.NutriLens.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_breakfast_label" />

            <com.google.android.material.chip.Chip
                android:id="@+id/thaliSlotLunch"
                style="@style/Widget.NutriLens.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_lunch_label" />

            <com.google.android.material.chip.Chip
                android:id="@+id/thaliSlotDinner"
                style="@style/Widget.NutriLens.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_dinner_label" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogThali"
            style="@style/Widget.NutriLens.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/log_meal" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
