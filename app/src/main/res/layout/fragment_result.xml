<?xml version="1.0" encoding="utf-8"?>
<!--
  Recognition result. Order follows what people want to know: what is it, how sure,
  how much energy, how much did I eat, then save.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/NL.IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/NL.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/recognition_result" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Analysing: the photo with a scanning beam -->
        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp">

            <FrameLayout
                android:id="@+id/scanFrame"
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgScanning"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.NutriLens.Photo" />

                <View
                    android:id="@+id/scanLine"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_scan_line" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAnalyzing"
                style="@style/NL.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/analyzing_your_meal"
                android:textSize="22sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                app:trackThickness="4dp" />
        </LinearLayout>

        <!-- Could not recognise / no model -->
        <LinearLayout
            android:id="@+id/errorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvError"
                style="@style/NL.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickFood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/choose_food_manually" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetake"
                style="@style/Widget.NutriLens.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/retake_photo" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/contentColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgMeal"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:contentDescription="@string/cd_meal_photo"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.NutriLens.Photo" />

                <!-- Photo-quality warning -->
                <LinearLayout
                    android:id="@+id/qualityBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_notice"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvQuality"
                        style="@style/NL.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/conf_mid_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetakeQuality"
                        style="@style/Widget.NutriLens.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/retake"
                        android:textColor="@color/conf_mid_text" />
                </LinearLayout>

                <!-- What it is -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvName"
                        style="@style/NL.Heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/food"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/tvCuisineBadge"
                        style="@style/NL.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/indian_cuisine_badge"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvChange"
                    style="@style/NL.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:text="@string/not_right_change_food" />

                <!-- Unsure about the photo: the top guesses as photo cards -->
                <LinearLayout
                    android:id="@+id/guessPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/NL.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/which_one_is_it" />

                    <TextView
                        style="@style/NL.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/which_one_is_it_sub" />

                    <LinearLayout
                        android:id="@+id/guessRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsAlternatives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="8dp" />

                <TextView
                    android:id="@+id/tvPersonalized"
                    style="@style/NL.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/adjusted_using_your_past_corrections"
                    android:visibility="gone" />

                <!-- Nutrition at a glance -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.NutriLens.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:stateListAnimator="@null">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCal"
                                style="@style/NL.Number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/n_0_2" />

                            <TextView
                                style="@style/NL.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/kcal"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvServing"
                            style="@style/NL.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/outline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/macroProtein"
                                layout="@layout/layout_macro_cell"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/macroCarbs"
                                layout="@layout/layout_macro_cell"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/macroFat"
                                layout="@layout/layout_macro_cell"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/macroFiber"
                                layout="@layout/layout_macro_cell"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvExtraNutrients"
                            style="@style/NL.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- How much (the picker has its own title) -->
                <include
                    android:id="@+id/portionPicker"
                    layout="@layout/layout_portion_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp" />

                <!-- This meal: items, more foods, slot -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.NutriLens.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:stateListAnimator="@null">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/NL.Section"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/this_meal" />

                            <TextView
                                android:id="@+id/tvMealTotal"
                                style="@style/NL.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/itemsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/regionProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMarkRegion"
                                style="@style/Widget.NutriLens.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="@string/mark_on_photo" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddFood"
                                style="@style/Widget.NutriLens.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="@string/add_food" />
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipsSlot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:chipSpacingHorizontal="8dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/slotBreakfast"
                                style="@style/Widget.NutriLens.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/slot_breakfast_label" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/slotLunch"
                                style="@style/Widget.NutriLens.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/slot_lunch_label" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/slotSnacks"
                                style="@style/Widget.NutriLens.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/slot_snacks_label" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/slotDinner"
                                style="@style/Widget.NutriLens.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/slot_dinner_label" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Less often needed: tap a row to open it -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.NutriLens.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:stateListAnimator="@null">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/rowCooking"
                            style="@style/NL.ExpandRow">

                            <TextView
                                style="@style/NL.Value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/cooking_style_title" />

                            <TextView
                                android:id="@+id/tvCookingSummary"
                                style="@style/NL.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <ImageView
                                android:id="@+id/chevCooking"
                                style="@style/NL.ExpandChevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cookingContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipsCookingStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:chipSpacingHorizontal="8dp"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStyleHomestyle"
                                    style="@style/Widget.NutriLens.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/style_less_oil" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStyleStandard"
                                    style="@style/Widget.NutriLens.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="@string/style_standard" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipStyleRestaurant"
                                    style="@style/Widget.NutriLens.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/style_extra_oil" />
                            </com.google.android.material.chip.ChipGroup>

                            <TextView
                                style="@style/NL.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/cooking_style_note" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="16dp"
                            android:background="@color/outline" />

                        <LinearLayout
                            android:id="@+id/rowScore"
                            style="@style/NL.ExpandRow">

                            <TextView
                                style="@style/NL.Value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nutrition_score" />

                            <TextView
                                android:id="@+id/tvScoreSummary"
                                style="@style/NL.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <ImageView
                                android:id="@+id/chevScore"
                                style="@style/NL.ExpandChevron" />
                        </LinearLayout>

                        <include
                            android:id="@+id/scoreCard"
                            layout="@layout/layout_score_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/NL.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/values_are_estimates_a_typical_serving" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetails"
                    style="@style/Widget.NutriLens.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/view_details" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Always in reach: what is being saved, its total, and Save -->
    <LinearLayout
        android:id="@+id/saveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBarTotal"
                    style="@style/NL.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvBarItems"
                    style="@style/NL.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="152dp"
                android:text="@string/save_meal"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
