<?xml version="1.0" encoding="utf-8"?>
<!-- Scanning beam over the photo while the model runs: a soft green glow ending in a bright line. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#8834C759"
                android:startColor="#0034C759" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape>
            <gradient
                android:centerColor="#FFB9F6CA"
                android:endColor="#0034C759"
                android:startColor="#0034C759" />
        </shape>
    </item>
</layer-list>
